# Base de la API. Vacío = usa el proxy /api de Vite hacia http://localhost:3100.
# En Vercel: la URL completa del backend en Heroku, sin sufijo /api
# (ej. https://tu-backend.herokuapp.com).
VITE_API_URL=
# Client ID de Google OAuth (opcional; debe coincidir con GOOGLE_OAUTH_CLIENT_ID del backend)
VITE_GOOGLE_OAUTH_CLIENT_ID=
